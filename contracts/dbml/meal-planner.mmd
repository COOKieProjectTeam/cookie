%% meal-planner service schema — derived from meal-planner.dbml
%% Cross-service references are intentionally omitted.
erDiagram
  Jobs {
    uuid id PK
    uuid user_id
    date from_date
    date to_date
    varchar status
    decimal progress
    uuid meal_plan_id
    timestamptz created_at
    timestamptz started_at
    timestamptz completed_at
    varchar error_code
  }

  Plans {
    uuid id PK
    uuid user_id
    date from_date
    date to_date
    timestamptz created_at
    varchar algorithm_version
  }

  PlanDays {
    uuid id PK
    uuid meal_plan_id
    date local_date
  }

  PlannedCooks {
    uuid id PK
    uuid plan_id
    date cook_date
    uuid recipe_id
    integer recipe_version
    uuid variant_id
    jsonb excluded_line_ids
    decimal ingredient_scale
    decimal planned_yield_amount
    varchar planned_yield_unit
  }

  PlanItems {
    uuid id PK
    uuid meal_plan_day_id
    varchar meal_type
    uuid planned_cook_id
    decimal planned_amount
    varchar planned_unit
    integer position
  }

  Plans ||--o{ PlanDays : "meal_plan_id"
  Plans ||--o{ PlannedCooks : "plan_id"
  PlanDays ||--o{ PlanItems : "meal_plan_day_id"
  PlannedCooks ||--o{ PlanItems : "planned_cook_id"
