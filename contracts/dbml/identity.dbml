// COOKie — Identity Service database schema
//
// Only Identity owns these tables. IDs carried to other services are logical
// references; cross-service foreign keys are forbidden.

Table accounts as Accounts {
  id uuid [pk, note: 'UUIDv7 generated by Identity']
  status varchar [not null, note: 'PENDING_VERIFICATION | ACTIVE; account.created is emitted once on transition to ACTIVE']
  created_at timestamptz [not null]
  activated_at timestamptz [null]

  Note: 'Service: Identity'
}

Table email_credentials as EmailCredentials {
  account_id uuid [pk, ref: - Accounts.id]
  email varchar [not null, unique, note: 'trim + NFC; ASCII local part; IDNA lower-case domain ending in ru or xn--p1ai']
  password_hash varchar [not null, note: 'Argon2id PHC: m=19456 KiB, t=2, p=1, salt=16 bytes, output=32 bytes']
  email_verified_at timestamptz [null]
  failed_login_count integer [not null, default: 0]
  locked_until timestamptz [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Service: Identity. One email/password credential per account'
}

Table auth_action_tokens as AuthActionTokens {
  id uuid [pk, note: 'UUIDv7 token id embedded in v1.<id>.<secret>']
  account_id uuid [not null, ref: > Accounts.id]
  purpose varchar [not null, note: 'EMAIL_VERIFICATION']
  token_hash varchar [not null, note: 'SHA-256 of the random verifier; raw token is never stored']
  expires_at timestamptz [not null]
  consumed_at timestamptz [null]
  revoked_at timestamptz [null]
  created_at timestamptz [not null]

  indexes {
    (account_id, purpose, created_at) [name: 'idx_auth_action_tokens_account_purpose']
    (expires_at) [name: 'idx_auth_action_tokens_expires_at']
  }

  Note: 'Service: Identity. Verification tokens are single-use and expire after 30 minutes'
}

Table refresh_sessions as RefreshSessions {
  id uuid [pk, note: 'UUIDv7 session id embedded in v1.<id>.<secret>']
  account_id uuid [not null, ref: > Accounts.id]
  family_id uuid [not null, note: 'stable UUIDv7 id for rotation and replay detection']
  token_hash varchar [not null, note: 'SHA-256 verifier; raw refresh token exists only on the client']
  status varchar [not null, note: 'ACTIVE | ROTATED | REVOKED']
  device_id varchar [null]
  replaced_by_session_id uuid [null, ref: > RefreshSessions.id]
  family_expires_at timestamptz [not null, note: 'absolute 30-day family lifetime; rotation never extends it']
  created_at timestamptz [not null]
  last_used_at timestamptz [null]
  revoked_at timestamptz [null]
  revoke_reason varchar [null, note: 'LOGOUT | ROTATED | REPLAY_DETECTED']
  reuse_detected_at timestamptz [null]

  indexes {
    (account_id, status) [name: 'idx_refresh_sessions_account_status']
    (family_id) [name: 'idx_refresh_sessions_family']
    (family_expires_at) [name: 'idx_refresh_sessions_expires_at']
  }

  Note: 'Service: Identity. Reuse of a ROTATED token atomically revokes the whole family'
}

Table rate_limit_buckets as RateLimitBuckets {
  scope_key varchar [pk, note: 'route + truncated SHA-256 digest of canonical email, IP, token id or session id']
  window_started_at timestamptz [not null]
  attempt_count integer [not null]
  expires_at timestamptz [not null]

  indexes {
    (expires_at) [name: 'idx_rate_limit_buckets_expires_at']
  }

  Note: 'Service: Identity. PostgreSQL-backed counters shared by all replicas'
}

Table outbox_events as OutboxEvents {
  event_id uuid [pk, note: 'UUIDv7 used as JetStream Nats-Msg-Id']
  event_type varchar [not null]
  event_version integer [not null]
  aggregate_type varchar [not null]
  aggregate_id varchar [not null]
  payload jsonb [not null, note: 'notification payload contains compact JWE only, never the raw token/email']
  occurred_at timestamptz [not null]
  available_at timestamptz [not null]
  claimed_until timestamptz [null]
  published_at timestamptz [null]
  attempt_count integer [not null, default: 0]
  last_error varchar [null]

  indexes {
    (published_at, available_at) [name: 'idx_outbox_events_pending']
  }

  Note: 'Service: Identity. Claimed with FOR UPDATE SKIP LOCKED and marked only after JetStream ack'
}

Table inbox_events as InboxEvents {
  consumer varchar [not null]
  event_id uuid [not null]
  event_type varchar [not null]
  processed_at timestamptz [not null]

  indexes {
    (consumer, event_id) [pk]
  }

  Note: 'Service: Identity. Idempotency record commits with consumer effects'
}
