// COOKie — database-per-service schema, DBML for dbdiagram.io
//
// IMPORTANT: there are NO cross-service foreign keys in this project.
// Each service owns its own PostgreSQL database. References between services
// are logical IDs only; never join tables across service databases.
// Grouping below (via `Note`) marks which tables belong to which service;
// `Ref` lines only connect tables WITHIN the same service.

//////////////////////////////////////////////////////////////////////////
// IDENTITY SERVICE
//////////////////////////////////////////////////////////////////////////

Table identity_accounts as IDA {
  id uuid [pk, note: 'UUIDv7 generated by Identity']
  status varchar [not null, default: 'ACTIVE', note: 'ACTIVE | DELETION_PENDING; deletion is irreversible in v1']
  created_at timestamptz [not null]

  Note: 'Service: Identity aggregate root. Created only after proof-bound email registration succeeds; v1 transitions only ACTIVE -> DELETION_PENDING'
}

Table identity_email_credentials as IDE {
  account_id uuid [pk, ref: - IDA.id]
  email varchar [not null, unique, note: 'canonical structural value: ASCII local part + UTS #46 IDNA lower-case domain; new registrations currently admit ru or xn--p1ai']
  password_hash varchar [not null, note: 'Argon2id PHC copied from the winning registration attempt']
  failed_login_count integer [not null, default: 0]
  locked_until timestamptz [null, note: 'Login backoff; account deletion also writes a far-future value so rolling old binaries deny login while they still ignore identity_accounts.status']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Service: Identity. One email/password credential per account; email and Argon2id hash are retained while distributed deletion is pending'
}

Table identity_account_deletion_requests as IDADR {
  id uuid [pk, note: 'Server-generated UUIDv7 returned as deletionRequestId']
  account_id uuid [not null, ref: > IDA.id, note: 'Restrictive/default NO ACTION ownership FK; deletion must never cascade away workflow evidence']
  idempotency_key uuid [not null, note: 'Client-generated RFC 4122 UUIDv4 scoped to the account; never logged or copied into events']
  status varchar [not null, note: 'DELETION_PENDING is the only state implemented in v1']
  requested_at timestamptz [not null, note: 'PostgreSQL-backed command time returned unchanged on every accepted retry']

  indexes {
    (account_id, idempotency_key) [unique, name: 'uq_identity_account_deletion_requests_account_key', note: 'One account + one key always identifies the same accepted request']
    (account_id) [unique, name: 'uq_identity_account_deletion_requests_pending_account', note: 'Partial: WHERE status = DELETION_PENDING; prevents concurrent active deletion processes for one account']
    (requested_at, id) [name: 'idx_identity_account_deletion_requests_requested_at', note: 'Supports deterministic lifecycle/reconciliation scans without deleting pending evidence']
  }

  Note: 'Service: Identity aggregate root. Exact retries and later keys return this row; wrong-password attempts create no row. There is no v1 completion, grace period or cancellation'
}

Table identity_registration_attempts as IDRA {
  id uuid [pk, note: 'Client-generated cryptographically random idempotency/correlation UUID for one logical signup attempt']
  email varchar [not null, note: 'canonical target email; no account exists yet']
  registration_proof_hash varchar [not null, note: 'SHA-256 of the independent client-held proof']
  request_fingerprint varchar [not null, note: 'keyed fingerprint used to distinguish an exact retry from conflicting proof reuse']
  locale varchar [null, note: 'canonical BCP 47 tag retained for localized resend and scrubbed on completion or abandonment']
  pending_password_hash varchar [null, note: 'Argon2id PHC while active; scrubbed on completion or abandonment']
  expires_at timestamptz [not null, note: 'absolute attempt lifetime; resend never extends it']
  completed_at timestamptz [null, note: 'first successful completion time']
  abandoned_at timestamptz [null, note: 'terminal time for natural expiry or superseding confirmation; mutually exclusive with completed_at']
  activated_account_id uuid [null, note: 'logical winning account id retained as bounded idempotency evidence; deliberately no FK so account privacy deletion neither blocks nor removes the tombstone']
  created_at timestamptz [not null]

  indexes {
    (id, expires_at) [unique, name: 'uq_identity_registration_attempts_id_expiry', note: 'Supports the child composite FK for immutable aggregate expiry']
    (registration_proof_hash) [unique, name: 'uq_identity_registration_attempts_registration_proof', note: 'A client proof belongs to exactly one registration request globally']
    (expires_at, id) [name: 'idx_identity_registration_attempts_pending_expiry', note: 'Partial: WHERE completed_at IS NULL AND abandoned_at IS NULL']
    (completed_at, id) [name: 'idx_identity_registration_attempts_completed_at', note: 'Partial: WHERE completed_at IS NOT NULL']
    (abandoned_at, id) [name: 'idx_identity_registration_attempts_abandoned_at', note: 'Partial: WHERE abandoned_at IS NOT NULL']
    (activated_account_id) [unique, name: 'uq_identity_registration_attempts_activated_account', note: 'Partial: WHERE activated_account_id IS NOT NULL']
  }

  Note: 'Service: Identity aggregate root. Registration proof reuse is rejected while evidence is retained; resends add child tokens; terminal rows scrub password/locale and completed or abandoned rows retain bounded idempotency evidence'
}

Table identity_registration_verification_tokens as IDRVT {
  id uuid [pk, note: 'Server-generated UUIDv7 token id embedded with attempt id in the v1e opaque email token']
  attempt_id uuid [not null, note: 'part of composite FK -> identity_registration_attempts.(id, expires_at)']
  attempt_expires_at timestamptz [not null, note: 'immutable parent expiry copied for the composite FK and lifetime CHECK']
  verifier_hash varchar [not null, note: 'SHA-256 verifier; raw email token is never stored']
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  redeemed_at timestamptz [null, note: 'only the winning token is marked redeemed']

  indexes {
    (attempt_id, issued_at, id) [name: 'idx_identity_registration_verification_tokens_attempt_issued']
    (attempt_id) [name: 'uq_identity_registration_verification_tokens_redeemed', note: 'Partial unique: WHERE redeemed_at IS NOT NULL']
  }

  Note: 'Service: Identity aggregate child. Composite FK enforces the copied immutable parent expiry and cascades deletion'
}

Table identity_refresh_families as IDRF {
  id uuid [pk, note: 'stable UUIDv7 id of one logical device session']
  account_id uuid [not null, ref: > IDA.id]
  device_id varchar [null, note: 'Opaque client-installation id; 1..255 Unicode code points, non-blank and without control characters']
  status varchar [not null, note: 'ACTIVE | REVOKED']
  expires_at timestamptz [not null, note: 'absolute family lifetime; credential rotation never extends it']
  created_at timestamptz [not null]
  last_activity_at timestamptz [not null]
  revoked_at timestamptz [null]
  revoke_reason varchar [null, note: 'LOGOUT | TOKEN_REUSE_DETECTED; v1 account deletion persists LOGOUT as a rolling-compatible technical reason while identity_accounts.status carries the lifecycle cause']
  reuse_detected_at timestamptz [null]

  indexes {
    (account_id, status) [name: 'idx_identity_refresh_families_account_status']
    (expires_at) [name: 'idx_identity_refresh_families_expires_at']
  }

  Note: 'Service: Identity aggregate root. Credential reuse atomically revokes the logical device session'
}

Table identity_refresh_credentials as IDRC {
  id uuid [pk, note: 'UUIDv7 credential id embedded in the opaque token']
  family_id uuid [not null, ref: > IDRF.id]
  verifier_hash varchar [not null, note: 'SHA-256 verifier; raw refresh token is never persisted']
  created_at timestamptz [not null]
  redeemed_at timestamptz [null]
  replaced_by_credential_id uuid [null, unique, ref: > IDRC.id]
  rotation_idempotency_key uuid [null, note: 'same key permits exact replay while the immediate successor remains current']
  retry_until timestamptz [null, note: 'compatibility deadline; new rotations set it to family expiry']

  indexes {
    (family_id, id) [unique, name: 'uq_identity_refresh_credentials_family_id_id']
    (family_id, created_at, id) [name: 'idx_identity_refresh_credentials_family_created']
  }

  Note: 'Service: Identity aggregate child. At most one unredeemed credential per family (partial unique index); replacement must stay in-family'
}

Table identity_rate_limit_buckets as IDRL {
  scope_key varchar [pk, note: 'route + namespace-separated truncated HMAC-SHA-256 identifier of canonical email, IP, token id or refresh family id']
  window_started_at timestamptz [not null]
  attempt_count integer [not null]
  expires_at timestamptz [not null]
  indexes {
    (expires_at) [name: 'idx_identity_rate_limit_buckets_expires_at']
  }
  Note: 'Service: Identity. PostgreSQL-backed shared rate limits'
}

Table identity_outbox_events as IDOE {
  event_id uuid [pk]
  event_type varchar [not null]
  event_version integer [not null]
  aggregate_type varchar [not null]
  aggregate_id varchar [not null]
  payload jsonb [not null]
  occurred_at timestamptz [not null]
  available_at timestamptz [not null]
  correlation_id uuid [null]
  causation_id uuid [null]
  trace_id varchar [null]
  claim_id uuid [null, note: 'fencing token for the current publisher lease']
  claimed_until timestamptz [null]
  published_at timestamptz [null]
  attempt_count integer [not null, default: 0]
  last_error varchar [null]
  indexes {
    (available_at, occurred_at) [name: 'idx_identity_outbox_events_pending']
    (claimed_until) [name: 'idx_identity_outbox_events_expired_claims']
    (published_at, event_id) [name: 'idx_identity_outbox_events_published_cleanup']
  }
  Note: 'Service: Identity. Transactional outbox; pending/claim indexes are partial on unpublished rows and cleanup index is partial on published rows'
}

//////////////////////////////////////////////////////////////////////////
// USER SERVICE
//////////////////////////////////////////////////////////////////////////

Table user_profiles as Profiles {
  user_id uuid [pk, note: 'logical ref -> Identity.accounts.id, no FK']
  sex varchar
  birth_date date
  height_cm decimal(5,2)
  activity_level varchar [note: 'LOW | MODERATE | HIGH']
  timezone varchar [not null, default: 'UTC']
  locale varchar [not null, default: 'ru']
  onboarding_completed boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  profile_version bigint [not null, default: 1, note: 'Exposed as Profile.version; profile PATCH only']
  aggregate_version bigint [not null, default: 1, note: 'Account-wide User event sequence']
  goal_revision bigint [not null, default: 0]
  hydration_revision bigint [not null, default: 0]

  Note: 'Service: User'
}

Table user_nutrition_goal_versions as NutritionGoalVersions {
  id uuid [pk]
  user_id uuid [not null, ref: > Profiles.user_id]
  revision bigint [not null, note: 'Per-user nutrition goal revision; immutable']
  effective_from date [not null]
  target_weight_kg decimal(6,2)
  target_weight_change_per_week decimal(4,2)
  calorie_target decimal(8,2) [not null]
  protein_g decimal(8,2) [not null]
  fat_g decimal(8,2) [not null]
  carbs_g decimal(8,2) [not null]
  fiber_g decimal(8,2) [not null]
  source varchar [not null, note: 'CALCULATED | MANUAL']
  created_at timestamptz [not null]

  indexes {
    (user_id, effective_from) [name: 'idx_goal_versions_user_date']
  }

  Note: 'Service: User'
}

Table user_hydration_goal_versions as HydrationGoalVersions {
  id uuid [pk]
  user_id uuid [not null, ref: > Profiles.user_id]
  revision bigint [not null, note: 'Per-user hydration goal revision; immutable']
  effective_from date [not null]
  target_ml integer [not null]
  source varchar [not null, note: 'CALCULATED | MANUAL']
  created_at timestamptz [not null]

  Note: 'Service: User'
}

Table user_diet_preferences as DietPreferences {
  user_id uuid [not null, ref: > Profiles.user_id]
  diet_type varchar [not null, note: 'BALANCED | HIGH_PROTEIN | VEGETARIAN | VEGAN | PESCATARIAN | LOW_CARB | KETO | MEDITERRANEAN | GLUTEN_FREE | LACTOSE_FREE']

  indexes {
    (user_id, diet_type) [pk]
  }

  Note: 'Service: User'
}

Table user_allergies as Allergies {
  user_id uuid [not null, ref: > Profiles.user_id]
  allergen varchar [not null, note: 'GLUTEN | CRUSTACEANS | EGGS | FISH | PEANUTS | SOY | MILK | TREE_NUTS | CELERY | MUSTARD | SESAME | SULPHITES | LUPIN | MOLLUSCS']

  indexes {
    (user_id, allergen) [pk]
  }

  Note: 'Service: User'
}

Table user_daily_goal_overrides as DailyGoalOverrides {
  id uuid [pk]
  user_id uuid [not null, ref: > Profiles.user_id]
  local_date date [not null]
  calorie_target decimal(8,2) [null]
  protein_g decimal(8,2) [null]
  fat_g decimal(8,2) [null]
  carbs_g decimal(8,2) [null]
  fiber_g decimal(8,2) [null]
  unlimited_calories boolean [not null, default: false]
  type varchar [not null, note: 'CUSTOM | CHEAT_DAY']
  cheat_month date [null, note: 'Generated from local_date for CHEAT_DAY; NULL otherwise']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, local_date) [unique]
    (user_id, cheat_month) [unique, note: 'Generated nullable cheat_month enforces one cheat day per account/month']
  }

  Note: 'Service: User'
}

Table user_account_tombstones as UserTombstones {
  user_id uuid [pk]
  deletion_request_id uuid [not null]
  deleted_at timestamptz [not null]
  Note: 'User: append-only runtime grants; prevents late activation/JWT replay'
}
Table user_idempotency_commands as UserCommands {
  user_id uuid [not null, ref: > Profiles.user_id]
  operation text [not null]
  key uuid [not null]
  fingerprint text [not null]
  response jsonb [not null]
  created_at timestamptz [not null]
  indexes { (user_id, operation, key) [pk] }
  Note: 'User: immutable evidence; erased by profile cascade'
}
Table user_inbox_events as UserInbox {
  consumer_name text [not null]
  event_id uuid [not null]
  event_type text [not null]
  processed_at timestamptz [not null]
  indexes { (consumer_name, event_id) [pk] }
  Note: 'User: lifecycle effect and inbox commit together'
}
Table user_outbox_events as UserOutbox {
  event_id uuid [pk]
  user_id uuid [not null]
  event_type text [not null]
  aggregate_version bigint [not null]
  payload jsonb [not null]
  occurred_at timestamptz [not null]
  available_at timestamptz [not null]
  claim_id uuid
  claimed_until timestamptz
  attempt_count integer [not null]
  published_at timestamptz
  last_error text
  Note: 'User: immutable payload; runtime updates delivery columns only. RLS deletion requires account tombstone'
}
Table user_message_quarantine as UserQuarantine {
  message_hash text [pk]
  subject text [not null]
  reason text [not null]
  stream_sequence bigint [not null]
  created_at timestamptz [not null]
  Note: 'User: metadata only; original broker replay limited by stream retention'
}

//////////////////////////////////////////////////////////////////////////
// FOOD CATALOG SERVICE
//////////////////////////////////////////////////////////////////////////

Table food_catalog_custom_foods as FCF {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  name varchar [not null]
  brand varchar [null]
  base_unit varchar [not null, note: 'G | ML']
  calories_per_100 decimal(10,3)
  protein_per_100 decimal(10,3)
  fat_per_100 decimal(10,3)
  carbs_per_100 decimal(10,3)
  fiber_per_100 decimal(10,3)
  archived boolean [not null, default: false]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  version bigint [not null, default: 1]

  Note: 'Service: Food Catalog. Open Food Facts data is NOT persisted — Redis cache only (off:search:<hash> TTL 10m, off:barcode:<code> TTL 1h)'
}

Table food_catalog_custom_food_serving as FCS {
  food_id uuid [pk, ref: - FCF.id]
  name varchar [not null, default: 'piece']
  base_amount decimal(10,3) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Service: Food Catalog'
}

//////////////////////////////////////////////////////////////////////////
// NUTRITION SERVICE
//////////////////////////////////////////////////////////////////////////

// Nutrition physical schema. One database, no cross-service foreign keys.
// JSONB nutrient values remain exact numeric decimals; HTTP nutrient strings are transport-only.
// Application transaction enforces per-user/local-day water sum <= 2147483647 ml.
// Documents contain owned dish/item snapshots; migrations are authoritative.

Table meals {
  id uuid [pk]
  user_id uuid [not null]
  client_generated_id uuid [not null]
  request_hash varchar(64) [not null]
  local_date date [not null]
  version bigint [not null]
  document jsonb [note: 'NULL is a retained idempotency tombstone; live owned snapshot otherwise']
  indexes {
    (user_id, client_generated_id) [unique]
    (user_id, local_date)
  }
}

Table water_entries {
  id uuid [pk]
  user_id uuid [not null]
  client_generated_id uuid [not null]
  request_hash varchar(64) [not null]
  local_date date [not null]
  version bigint [not null]
  document jsonb [note: 'NULL is a retained idempotency tombstone; live owned snapshot otherwise']
  indexes {
    (user_id, client_generated_id) [unique]
    (user_id, local_date)
  }
}

Table saved_dishes {
  id uuid [pk]
  user_id uuid [not null]
  version bigint [not null]
  document jsonb [not null, note: 'Owned template with complete editable item snapshots']
}
Table nutrition_day_versions {
  user_id uuid [not null]
  local_date date [not null]
  kind varchar(16) [not null, note: 'day | water']
  version bigint [not null]
  indexes { (user_id, local_date, kind) [pk] }
}
Table nutrition_account_tombstones {
  user_id uuid [pk]
  deletion_request_id uuid [not null]
  deleted_at timestamptz [not null]
}
Table nutrition_inbox_events {
  event_id uuid [pk]
  received_at timestamptz [not null]
}
Table nutrition_outbox_events {
  event_id uuid [pk]
  user_id uuid [not null]
  envelope jsonb [not null]
  subject varchar(200) [not null]
  occurred_at timestamptz [not null]
  available_at timestamptz [not null]
  claim_id uuid
  claimed_until timestamptz
  published_at timestamptz
  attempts integer [not null]
}
Table nutrition_rejected_events {
  stream_sequence bigint [pk]
  reason varchar(64) [not null]
  rejected_at timestamptz [not null]
}

//////////////////////////////////////////////////////////////////////////
// RECIPE SERVICE
//////////////////////////////////////////////////////////////////////////

Table recipe_ingredients as RI {
  id uuid [pk]
  name varchar [not null]
  base_unit varchar [not null, note: 'G | ML']
  calories_per_100 decimal(10,3)
  protein_per_100 decimal(10,3)
  fat_per_100 decimal(10,3)
  carbs_per_100 decimal(10,3)
  fiber_per_100 decimal(10,3)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Service: Recipe. Canonical cooking ingredient — distinct from Food Catalog product'
}

Table recipe_ingredient_allergens as RIA {
  ingredient_id uuid [not null, ref: > RI.id]
  allergen varchar [not null]

  indexes {
    (ingredient_id, allergen) [pk]
  }

  Note: 'Service: Recipe'
}

Table recipes as R {
  id uuid [pk]
  status varchar [not null, note: 'DRAFT | PUBLISHED | ARCHIVED']
  current_version integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Service: Recipe'
}

Table recipe_versions as RV {
  id uuid [pk]
  recipe_id uuid [not null, ref: > R.id]
  version_number integer [not null]
  title varchar [not null]
  description text
  default_servings decimal(6,2) [not null]
  prep_seconds integer
  cook_seconds integer
  difficulty varchar [note: 'EASY | MEDIUM | HARD']
  published_at timestamptz [null]

  indexes {
    (recipe_id, version_number) [unique]
  }

  Note: 'Service: Recipe'
}

Table recipe_version_nutrition as RVN {
  recipe_version_id uuid [pk, ref: - RV.id]
  calories_total decimal(10,3)
  protein_total decimal(10,3)
  fat_total decimal(10,3)
  carbs_total decimal(10,3)
  fiber_total decimal(10,3)
  calories_per_serving decimal(10,3)
  protein_per_serving decimal(10,3)
  fat_per_serving decimal(10,3)
  carbs_per_serving decimal(10,3)
  fiber_per_serving decimal(10,3)

  Note: 'Service: Recipe. Precomputed snapshot at publish time — GET does not recalculate every time'
}

Table recipe_version_photos as RVP {
  recipe_version_id uuid [not null, ref: > RV.id]
  media_id uuid [not null, note: 'logical ref -> Media.media_objects.id']
  position integer [not null]

  indexes {
    (recipe_version_id, media_id) [pk]
  }

  Note: 'Service: Recipe'
}

Table recipe_version_ingredients as RVI {
  id uuid [pk]
  recipe_version_id uuid [not null, ref: > RV.id]
  ingredient_id uuid [not null, ref: > RI.id]
  amount_base decimal(12,3) [not null]
  position integer [not null]

  Note: 'Service: Recipe'
}

Table recipe_steps as RS {
  id uuid [pk]
  recipe_version_id uuid [not null, ref: > RV.id]
  position integer [not null]
  text text [not null]
  duration_seconds integer [null]

  Note: 'Service: Recipe'
}

Table recipe_tags as RT {
  recipe_version_id uuid [not null, ref: > RV.id]
  tag_type varchar [not null]
  tag_value varchar [not null]

  Note: 'Service: Recipe'
}

Table recipe_user_customizations as RUC {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  recipe_id uuid [not null, ref: > R.id]
  base_recipe_version_id uuid [not null, ref: > RV.id]
  revision bigint [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, recipe_id) [unique]
  }

  Note: 'Service: Recipe'
}

Table recipe_customization_ingredients as RCI {
  customization_id uuid [not null, ref: > RUC.id]
  ingredient_id uuid [not null, ref: > RI.id]
  amount_base decimal(12,3) [not null]
  position integer [not null]

  Note: 'Service: Recipe'
}

Table recipe_favorites as RF {
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  recipe_id uuid [not null, ref: > R.id]
  created_at timestamptz [not null]

  indexes {
    (user_id, recipe_id) [pk]
  }

  Note: 'Service: Recipe'
}

Table recipe_feedback as RFB {
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  recipe_id uuid [not null, ref: > R.id]
  feedback varchar [not null, note: 'LIKE | DO_NOT_RECOMMEND']
  updated_at timestamptz [not null]

  indexes {
    (user_id, recipe_id) [pk]
  }

  Note: 'Service: Recipe'
}

Table recipe_cooking_sessions as RCS {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  recipe_id uuid [not null, ref: > R.id]
  recipe_version integer [not null]
  customization_revision bigint [null]
  servings decimal(6,2) [not null]
  status varchar [not null, note: 'IN_PROGRESS | COMPLETED | CANCELLED']
  started_at timestamptz [not null]
  completed_at timestamptz [null]

  Note: 'Service: Recipe'
}

//////////////////////////////////////////////////////////////////////////
// SHOPPING SERVICE
//////////////////////////////////////////////////////////////////////////

Table shopping_carts as SC {
  id uuid [pk]
  user_id uuid [not null, unique, note: 'logical ref -> Identity.accounts.id']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Service: Shopping'
}

Table shopping_cart_recipe_items as SCR {
  id uuid [pk]
  cart_id uuid [not null, ref: > SC.id]
  recipe_id uuid [not null, note: 'logical ref -> Recipe.recipes.id']
  recipe_version integer [not null]
  customization_revision bigint [null]
  recipe_title_snapshot varchar [not null]
  servings decimal(6,2) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Service: Shopping'
}

Table shopping_cart_import_jobs as SCIJ {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  meal_plan_id uuid [not null, note: 'logical ref -> Meal Planner.meal_plans.id']
  from_date date [not null]
  to_date date [not null]
  status varchar [not null, note: 'PENDING | RUNNING | COMPLETED | FAILED']
  cart_id uuid [null, ref: > SC.id]
  error_code varchar [null]
  created_at timestamptz [not null]
  completed_at timestamptz [null]

  indexes {
    (user_id, created_at) [name: 'idx_cart_import_jobs_user_created']
  }

  Note: 'Service: Shopping. Tracks asynchronous imports from Meal Planner and provides a pollable result'
}

Table shopping_cart_recipe_ingredients as SCI {
  cart_recipe_item_id uuid [not null, ref: > SCR.id]
  ingredient_id uuid [not null, note: 'logical ref -> Recipe.ingredients.id']
  ingredient_name_snapshot varchar [not null]
  base_amount_for_item decimal(12,3) [not null]
  base_unit varchar [not null]

  Note: 'Service: Shopping. Snapshot — never joins to Recipe DB'
}

Table shopping_adjustments as SA {
  cart_id uuid [not null, ref: > SC.id]
  ingredient_id uuid [not null, note: 'logical ref -> Recipe.ingredients.id']
  have_deduction decimal(12,3) [not null, default: 0]
  extra_amount decimal(12,3) [not null, default: 0]
  bought boolean [not null, default: false]
  updated_at timestamptz [not null]

  indexes {
    (cart_id, ingredient_id) [pk]
  }

  Note: 'Service: Shopping. required_amount is NOT stored — derived from shopping_cart_recipe_ingredients'
}

//////////////////////////////////////////////////////////////////////////
// HEALTH SERVICE
//////////////////////////////////////////////////////////////////////////

Table health_sources as HS {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  type varchar [not null, note: 'APPLE_HEALTH | HEALTH_CONNECT']
  device_id varchar [null]
  created_at timestamptz [not null]
  last_sync_at timestamptz [null]

  Note: 'Service: Health'
}

Table health_daily_activity_sources as HDA {
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  local_date date [not null]
  source varchar [not null]
  steps integer
  active_calories decimal(10,3)
  source_updated_at timestamptz [not null]
  received_at timestamptz [not null]

  indexes {
    (user_id, local_date, source) [pk]
  }

  Note: 'Service: Health'
}

Table health_weight_measurements as HW {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  value_kg decimal(6,2) [not null]
  measured_at timestamptz [not null]
  source varchar [not null, note: 'MANUAL | APPLE_HEALTH']
  external_id varchar [null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (user_id, source, external_id) [unique]
  }

  Note: 'Service: Health'
}

//////////////////////////////////////////////////////////////////////////
// PROGRESS SERVICE (event-driven read model)
//////////////////////////////////////////////////////////////////////////

Table progress_daily_progress as PDP {
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  local_date date [not null]
  calories_consumed decimal(10,3)
  protein_g decimal(10,3)
  fat_g decimal(10,3)
  carbs_g decimal(10,3)
  fiber_g decimal(10,3)
  water_ml integer
  steps integer
  active_calories decimal(10,3)
  calorie_target decimal(10,3)
  protein_target_g decimal(10,3)
  fat_target_g decimal(10,3)
  carbs_target_g decimal(10,3)
  fiber_target_g decimal(10,3)
  water_target_ml integer
  unlimited_calories boolean [not null, default: false]
  weight_kg decimal(6,2) [null]
  food_logged boolean [not null, default: false]
  updated_at timestamptz [not null]

  indexes {
    (user_id, local_date) [pk]
  }

  Note: 'Service: Progress. Built entirely from NATS events (nutrition.*, health.*, user.*) — never queries other service DBs directly'
}

Table progress_user_streaks as PUS {
  user_id uuid [pk, note: 'logical ref -> Identity.accounts.id']
  current_streak integer [not null, default: 0]
  longest_streak integer [not null, default: 0]
  last_logged_date date [null]
  updated_at timestamptz [not null]

  Note: 'Service: Progress'
}

//////////////////////////////////////////////////////////////////////////
// NOTIFICATION SERVICE
//////////////////////////////////////////////////////////////////////////

// COOKie — Notification Service PostgreSQL schema.
// Mirrors V001__notification_core.sql through V005__provider_retry_budget.sql.
// Cross-service identifiers are logical references only, never foreign keys.

Table notification_account_tombstones as NotificationAccountTombstones {
  user_id uuid [pk, note: 'Logical Identity account id. Prevents late events and residual JWTs from recreating deleted data']
  deletion_request_id uuid [not null]
  deleted_at timestamptz [not null]
  Note: 'Service: Notification. Minimal durable deletion evidence; not removed by ordinary retention'
}

Table notification_settings as NotificationSettings {
  user_id uuid [pk, note: 'Logical Identity account id']
  water_enabled boolean [not null, default: true]
  food_enabled boolean [not null, default: true]
  food_inactive_minutes integer [not null, default: 240, note: 'CHECK BETWEEN 1 AND 10080']
  weigh_enabled boolean [not null, default: true]
  weigh_time time [not null, default: '08:00']
  goal_warning_enabled boolean [not null, default: true]
  quiet_start time [not null, default: '23:00']
  quiet_end time [not null, default: '08:00']
  timezone varchar(255) [null, note: 'Notification settings are authoritative. No scheduled push before explicit IANA timezone']
  locale varchar(255) [not null, default: 'ru']
  locale_overridden boolean [not null, default: false]
  scheduling_started_at timestamptz [null]
  food_started_at timestamptz [null]
  water_started_at timestamptz [null]
  last_water_reminder_at timestamptz [null, note: 'Queue reservation time, separate from provider submission']
  last_water_submission_at timestamptz [null]
  last_water_submission_occurrence_id uuid [null, note: 'Same occurrence may fan out to several devices; different occurrences wait at least two hours']
  updated_at timestamptz [not null, default: `clock_timestamp()`]
  Note: 'Service: Notification. PostgreSQL owns timer baselines; profile locale only fills a non-overridden default'
}

Table notification_push_devices as NotificationPushDevices {
  id uuid [pk]
  user_id uuid [not null, note: 'Logical Identity account id']
  platform varchar(10) [not null, note: 'CHECK IOS | ANDROID']
  device_id varchar(255) [not null]
  push_token varchar(4096) [not null, note: 'Opaque case-sensitive FCM registration token for IOS and ANDROID; legacy IOS APNs registrations disabled by V006']
  push_token_hash bytea [not null, note: '32-byte SHA-256 of exact token; maintained by database trigger']
  enabled boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null, note: 'Revision guard for conditional provider token invalidation']
  indexes {
    (user_id, device_id) [unique]
    push_token_hash [unique, name: 'push_devices_active_token', note: 'Partial index WHERE enabled; one FCM token owner across platforms; bounded entries support the full 4096-character token contract']
    user_id [name: 'push_devices_user']
  }
  Note: 'Service: Notification'
}

Table notification_inbox_events as NotificationInboxEvents {
  consumer_name varchar(100) [not null]
  event_id uuid [not null]
  event_type varchar(100) [not null]
  processed_at timestamptz [not null, default: `clock_timestamp()`]
  indexes {
    (consumer_name, event_id) [pk]
    processed_at [name: 'inbox_events_retention']
  }
  Note: 'Service: Notification. Same transaction as projections and delivery intent; 30-day retention exceeds seven-day stream retention'
}

Table notification_event_projections as NotificationEventProjections {
  kind varchar(30) [not null, note: 'PROFILE | MEAL | WATER | WEIGHT | PROGRESS']
  user_id uuid [not null]
  entity_id varchar(255) [not null, note: 'Aggregate projection key; progress includes timezone and localDate']
  version bigint [not null, note: 'CHECK > 0. Older or equal aggregate versions never overwrite a projection']
  payload jsonb [not null, note: 'Allowlisted minimal notification snapshot; no dishes or weight values']
  deleted boolean [not null, default: false]
  updated_at timestamptz [not null, default: `clock_timestamp()`]
  indexes {
    (kind, user_id, entity_id) [pk]
    (user_id, kind) [name: 'event_projections_user']
  }
  Note: 'Service: Notification. Meal/weight tombstones prevent resurrection after out-of-order delivery'
}

Table notification_reminder_deadlines as NotificationReminderDeadlines {
  user_id uuid [pk]
  due_at timestamptz [not null]
  generation bigint [not null, default: 1]
  indexes {
    (due_at, user_id) [name: 'reminder_deadlines_due']
  }
  Note: 'Service: Notification. Canonical schedule, rebuilds Redis cookie:notification:reminder_deadlines members userId:generation; PostgreSQL fallback scans every 30 seconds'
}

Table notification_reminder_occurrences as NotificationReminderOccurrences {
  id uuid [pk]
  user_id uuid [not null]
  kind varchar(40) [not null]
  cycle_key varchar(255) [not null, note: 'Food activity cycle, water deadline or local date depending on kind']
  scheduled_at timestamptz [not null]
  last_submitted_at timestamptz [null, note: 'Durable submission evidence survives delivery-job retention; fully unsent FOOD and current-date daily reminders can resume after diary correction']
  created_at timestamptz [not null, default: `clock_timestamp()`]
  indexes {
    (user_id, kind, cycle_key) [unique]
    user_id [name: 'reminder_occurrences_user']
  }
  Note: 'Service: Notification. Logical occurrence deduplication across scheduler replicas'
}

Table notification_message_quarantine as NotificationMessageQuarantine {
  id uuid [pk]
  message_hash char(64) [not null, unique, note: 'SHA-256 of original envelope bytes']
  event_id uuid [null]
  subject varchar(255) [not null]
  reason varchar(100) [not null, note: 'Safe classified reason, not exception text']
  stream_sequence bigint [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]
  replay_requested_at timestamptz [null]
  replayed_at timestamptz [null]
  replay_attempts integer [not null, default: 0]
  indexes {
    replay_requested_at [name: 'quarantine_replay', note: 'Partial index WHERE replayed_at IS NULL']
    created_at [name: 'quarantine_retention']
  }
  Note: 'Service: Notification. Metadata only. Operator replay uses original retained broker message with separate credentials; no raw payload persisted'
}

Table notification_delivery_jobs as NotificationDeliveryJobs {
  id uuid [pk]
  dedup_key varchar(200) [not null, unique]
  channel varchar(8) [not null, note: 'CHECK EMAIL | PUSH']
  user_id uuid [null]
  device_id uuid [null, note: 'Logical local push device id; no FK so deletion/retention remains explicit']
  registration_attempt_id uuid [null, note: 'Pre-account email aggregate; not an Identity FK']
  occurrence_id uuid [null, note: 'Logical local reminder occurrence id']
  kind varchar(40) [not null]
  locale varchar(64) [not null, default: 'ru']
  encrypted_payload text [null, note: 'Compact JWE only; removed after terminal completion']
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `clock_timestamp()`]
  next_attempt_at timestamptz [not null, default: `clock_timestamp()`]
  status varchar(24) [not null, default: 'PENDING', note: 'CHECK PENDING | CLAIMED | SMTP_SUBMITTING | ACCEPTED | FAILED | UNKNOWN | CANCELLED | EXPIRED']
  attempt_count integer [not null, default: 0, note: 'CHECK >= 0; queue claims including technical deferrals']
  provider_failure_count integer [not null, default: 0, note: 'CHECK >= 0; retryable provider failures only, separate ten-failure budget and backoff']
  lease_token uuid [null]
  lease_until timestamptz [null]
  provider_message_id varchar(512) [null]
  last_code varchar(64) [null]
  finished_at timestamptz [null]
  indexes {
    (next_attempt_at, created_at) [name: 'delivery_jobs_pending', note: 'Partial index WHERE status = PENDING']
    expires_at [name: 'delivery_jobs_expiry', note: 'Partial index WHERE status = PENDING']
    lease_until [name: 'delivery_jobs_leases', note: 'Partial index WHERE status IN (CLAIMED, SMTP_SUBMITTING)']
    user_id [name: 'delivery_jobs_user', note: 'Partial index WHERE user_id IS NOT NULL']
    finished_at [name: 'delivery_jobs_finished', note: 'Partial index WHERE finished_at IS NOT NULL']
  }
  Note: 'Service: Notification. CHECK lease_token/lease_until both null or both set. EMAIL requires registration_attempt_id with null user_id/device_id; PUSH requires user_id/device_id with null registration_attempt_id. SMTP_SUBMITTING expired lease becomes terminal UNKNOWN, never an automatic retry. ACCEPTED means provider accepted, not proof of delivery'
}

Table notification_delivery_attempts as NotificationDeliveryAttempts {
  id uuid [pk]
  delivery_id uuid [not null]
  started_at timestamptz [not null, default: `clock_timestamp()`]
  finished_at timestamptz [null]
  outcome varchar(24) [null]
  safe_code varchar(64) [null]
  Note: 'Service: Notification. Id equals delivery claim fencing token; no provider payload or arbitrary errors'
}
Ref: NotificationDeliveryAttempts.delivery_id > NotificationDeliveryJobs.id [delete: cascade]

//////////////////////////////////////////////////////////////////////////
// MEDIA SERVICE
//////////////////////////////////////////////////////////////////////////

Table media_objects as MO {
  id uuid [pk]
  owner_user_id uuid [null, note: 'logical ref -> Identity.accounts.id']
  purpose varchar [not null, note: 'DISH_PHOTO | RECIPE_PHOTO | SAVED_DISH_PHOTO']
  storage_key varchar [not null]
  content_type varchar [not null]
  size_bytes bigint [not null]
  status varchar [not null, note: 'PENDING | READY | DELETED']
  created_at timestamptz [not null]
  completed_at timestamptz [null]
  deleted_at timestamptz [null]

  Note: 'Service: Media. Binary lives in S3-compatible Object Storage, not PostgreSQL'
}

//////////////////////////////////////////////////////////////////////////
// MEAL PLANNER SERVICE (premium)
//////////////////////////////////////////////////////////////////////////

Table meal_planner_jobs as MPJ {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  from_date date [not null]
  to_date date [not null]
  status varchar [not null, note: 'PENDING | RUNNING | COMPLETED | FAILED']
  progress decimal(4,3) [null]
  meal_plan_id uuid [null, note: 'logical ref -> meal_plans.id after successful generation']
  created_at timestamptz [not null]
  started_at timestamptz [null]
  completed_at timestamptz [null]
  error_code varchar [null]

  Note: 'Service: Meal Planner'
}

Table meal_plans as MP {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  from_date date [not null]
  to_date date [not null]
  created_at timestamptz [not null]
  algorithm_version varchar [not null]

  Note: 'Service: Meal Planner'
}

Table meal_plan_days as MPD {
  id uuid [pk]
  meal_plan_id uuid [not null, ref: > MP.id]
  local_date date [not null]

  Note: 'Service: Meal Planner'
}

Table meal_plan_items as MPI {
  id uuid [pk]
  meal_plan_day_id uuid [not null, ref: > MPD.id]
  meal_type varchar [not null, note: 'BREAKFAST | LUNCH | DINNER | SNACK']
  recipe_id uuid [not null, note: 'logical ref -> Recipe.recipes.id']
  recipe_version integer [not null]
  servings decimal(6,2) [not null]
  position integer [not null]

  Note: 'Service: Meal Planner'
}
