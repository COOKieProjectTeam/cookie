%% Identity Service schema — derived from identity.dbml
%% Cross-service references are intentionally omitted.
erDiagram
  Accounts {
    uuid id PK
    varchar status
    timestamptz created_at
    timestamptz activated_at
  }

  EmailCredentials {
    uuid account_id PK
    varchar email UK
    varchar password_hash
    timestamptz email_verified_at
    integer failed_login_count
    timestamptz locked_until
    timestamptz created_at
    timestamptz updated_at
  }

  AuthActionTokens {
    uuid id PK
    uuid account_id
    varchar purpose
    varchar token_hash
    timestamptz expires_at
    timestamptz consumed_at
    timestamptz revoked_at
    timestamptz created_at
  }

  RefreshSessions {
    uuid id PK
    uuid account_id
    uuid family_id
    varchar token_hash
    varchar status
    varchar device_id
    uuid replaced_by_session_id
    timestamptz family_expires_at
    timestamptz created_at
    timestamptz last_used_at
    timestamptz revoked_at
    varchar revoke_reason
    timestamptz reuse_detected_at
  }

  RateLimitBuckets {
    varchar scope_key PK
    timestamptz window_started_at
    integer attempt_count
    timestamptz expires_at
  }

  OutboxEvents {
    uuid event_id PK
    varchar event_type
    integer event_version
    varchar aggregate_type
    varchar aggregate_id
    jsonb payload
    timestamptz occurred_at
    timestamptz available_at
    uuid correlation_id
    uuid causation_id
    varchar trace_id
    uuid claim_id
    timestamptz claimed_until
    timestamptz published_at
    integer attempt_count
    varchar last_error
  }

  Accounts ||--o| EmailCredentials : "account_id"
  Accounts ||--o{ AuthActionTokens : "account_id"
  Accounts ||--o{ RefreshSessions : "account_id"
  RefreshSessions o|--o| RefreshSessions : "replaced_by_session_id"
