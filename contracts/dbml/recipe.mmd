%% recipe service schema — derived from recipe.dbml
%% Cross-service references are intentionally omitted.
erDiagram
  Ingredients {
    uuid id PK
    varchar name
    varchar base_unit
    decimal calories_per_100
    decimal protein_per_100
    decimal fat_per_100
    decimal carbs_per_100
    decimal fiber_per_100
    timestamptz created_at
    timestamptz updated_at
  }

  IngredientAllergens {
    uuid ingredient_id
    varchar allergen
  }

  Recipes {
    uuid id PK
    varchar status
    integer current_version
    timestamptz created_at
    timestamptz updated_at
  }

  Versions {
    uuid id PK
    uuid recipe_id
    integer version_number
    varchar title
    text description
    integer prep_seconds
    integer cook_seconds
    varchar difficulty
    timestamptz published_at
  }

  Variants {
    uuid id PK
    uuid recipe_version_id
    varchar label
    boolean is_default
    decimal yield_amount
    varchar yield_unit
    varchar piece_label
    decimal serving_amount
  }

  VersionNutrition {
    uuid variant_id PK
    decimal calories_total
    decimal protein_total
    decimal fat_total
    decimal carbs_total
    decimal fiber_total
    decimal calories_per_serving
    decimal protein_per_serving
    decimal fat_per_serving
    decimal carbs_per_serving
    decimal fiber_per_serving
  }

  VersionPhotos {
    uuid recipe_version_id
    uuid media_id
    integer position
  }

  VariantLines {
    uuid id PK
    uuid variant_id
    uuid ingredient_id
    uuid subrecipe_variant_id
    varchar layer
    boolean optional
    decimal input_amount
    varchar input_unit
    decimal prepared_amount
    varchar prepared_unit
    jsonb nutrient_basis
    integer position
  }

  Steps {
    uuid id PK
    uuid variant_id
    uuid optional_line_id
    integer position
    text text
    integer duration_seconds
  }

  Tags {
    uuid recipe_version_id
    varchar tag_type
    varchar tag_value
  }

  Favorites {
    uuid user_id
    uuid recipe_id
    timestamptz created_at
  }

  Feedback {
    uuid user_id
    uuid recipe_id
    varchar feedback
    timestamptz updated_at
  }

  CookingSessions {
    uuid id PK
    uuid user_id
    uuid variant_id
    jsonb excluded_line_ids
    uuid planned_cook_id
    decimal ingredient_scale
    decimal actual_yield_amount
    varchar actual_yield_unit
    varchar status
    timestamptz started_at
    timestamptz completed_at
  }

  Ingredients ||--o{ IngredientAllergens : "ingredient_id"
  Recipes ||--o{ Versions : "recipe_id"
  Versions ||--o{ Variants : "recipe_version_id"
  Variants ||--o| VersionNutrition : "variant_id"
  Versions ||--o{ VersionPhotos : "recipe_version_id"
  Variants ||--o{ VariantLines : "variant_id"
  Ingredients |o--o{ VariantLines : "ingredient_id"
  Variants |o--o{ VariantLines : "subrecipe_variant_id"
  Variants ||--o{ Steps : "variant_id"
  VariantLines |o--o{ Steps : "optional_line_id"
  Versions ||--o{ Tags : "recipe_version_id"
  Recipes ||--o{ Favorites : "recipe_id"
  Recipes ||--o{ Feedback : "recipe_id"
  Variants ||--o{ CookingSessions : "variant_id"
