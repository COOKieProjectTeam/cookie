%% Health tables. Composite keys and constraints are defined in Health migrations.
erDiagram
  HealthTombstones {
    uuid user_id PK
    uuid deletion_request_id
    timestamptz deleted_at
  }

  HealthInbox {
    text consumer_name
    uuid event_id
    text event_type
    timestamptz processed_at
  }

  HealthQuarantine {
    text message_hash PK
    text subject
    text reason
    bigint stream_sequence
    timestamptz created_at
  }

  HealthConnections {
    uuid user_id
    uuid id
    text platform
    text timezone
    text status
    bigint generation
    bigint version
    bigint next_seq
    date initial_from
    date initial_to
  }

  HealthPrimaryPeriods {
    uuid user_id
    date effective_from
    text timezone
    timestamptz effective_at
    uuid connection_id
    bigint revision
  }

  HealthSourceDays {
    uuid user_id
    uuid connection_id
    date local_date
    text timezone
    integer steps
    numeric active_kcal
    boolean deleted
  }

  HealthDayVersions {
    uuid user_id
    date local_date
    uuid connection_id
    text timezone
    bigint version
  }

  HealthWeights {
    uuid user_id
    uuid id
    text source
    uuid connection_id
    text external_id
    boolean first_weight
    bigint version
    numeric value_kg
    timestamptz measured_at
    boolean deleted
  }

  HealthBatches {
    uuid user_id
    uuid connection_id
    bigint generation
    bigint seq
    uuid idempotency_key
    text fingerprint
    jsonb response
    timestamptz created_at
  }

  HealthReceipts {
    uuid user_id
    text operation
    uuid key
    text fingerprint
    jsonb response
  }

  HealthPurges {
    uuid user_id
    uuid connection_id
    uuid id
    boolean completed
    timestamptz retry_at
  }

  HealthOutbox {
    uuid event_id PK
    uuid user_id
    text event_type
    uuid connection_id
    integer event_version
    text aggregate_type
    text aggregate_id
    bigint aggregate_version
    jsonb payload
    timestamptz occurred_at
    timestamptz available_at
    uuid claim_id
    timestamptz claimed_until
    integer attempt_count
    timestamptz published_at
    text last_error
  }

  HealthAssessmentExecutions {
    uuid user_id
    uuid attempt_id
    uuid receipt_id
    text encrypted_result
  }
