// COOKie — recipe service database schema
//
// This file contains only tables owned by the recipe service.
// Cross-service references are logical IDs only; never add cross-service foreign keys.

Table ingredients as Ingredients {
  id uuid [pk]
  name varchar [not null]
  base_unit varchar [not null, note: 'G | ML']
  calories_per_100 decimal(10,3)
  protein_per_100 decimal(10,3)
  fat_per_100 decimal(10,3)
  carbs_per_100 decimal(10,3)
  fiber_per_100 decimal(10,3)
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Service: Recipe. Canonical cooking ingredient — distinct from Food Catalog product'
}

Table ingredient_allergens as IngredientAllergens {
  ingredient_id uuid [not null, ref: > Ingredients.id]
  allergen varchar [not null]

  indexes {
    (ingredient_id, allergen) [pk]
  }

  Note: 'Service: Recipe'
}

Table recipes as Recipes {
  id uuid [pk]
  status varchar [not null, note: 'DRAFT | PUBLISHED | ARCHIVED']
  current_version integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Service: Recipe'
}

Table versions as Versions {
  id uuid [pk]
  recipe_id uuid [not null, ref: > Recipes.id]
  version_number integer [not null]
  title varchar [not null]
  description text
  prep_seconds integer
  cook_seconds integer
  difficulty varchar [note: 'EASY | MEDIUM | HARD']
  published_at timestamptz [null]

  indexes {
    (recipe_id, version_number) [unique]
  }

  Note: 'Service: Recipe'
}

Table recipe_variants as Variants {
  id uuid [pk]
  recipe_version_id uuid [not null, ref: > Versions.id]
  label varchar [not null]
  is_default boolean [not null]
  yield_amount decimal(12,3) [not null]
  yield_unit varchar [not null, note: 'G | ML | PIECE']
  piece_label varchar [note: 'packet, strip, bar, etc.']
  serving_amount decimal(12,3) [not null, note: 'positive, in yield_unit']
  Note: 'Published revision has exactly one default variant and positive yield.'
}

Table version_nutrition as VersionNutrition {
  variant_id uuid [pk, ref: - Variants.id]
  calories_total decimal(10,3)
  protein_total decimal(10,3)
  fat_total decimal(10,3)
  carbs_total decimal(10,3)
  fiber_total decimal(10,3)
  calories_per_serving decimal(10,3)
  protein_per_serving decimal(10,3)
  fat_per_serving decimal(10,3)
  carbs_per_serving decimal(10,3)
  fiber_per_serving decimal(10,3)

  Note: 'Service: Recipe. Precomputed snapshot at publish time — GET does not recalculate every time'
}

Table version_photos as VersionPhotos {
  recipe_version_id uuid [not null, ref: > Versions.id]
  media_id uuid [not null, note: 'logical ref -> Media.media_objects.id']
  position integer [not null]

  indexes {
    (recipe_version_id, media_id) [pk]
  }

  Note: 'Service: Recipe'
}

Table variant_lines as VariantLines {
  id uuid [pk]
  variant_id uuid [not null, ref: > Variants.id]
  ingredient_id uuid [ref: > Ingredients.id]
  subrecipe_variant_id uuid [ref: > Variants.id]
  layer varchar [not null]
  optional boolean [not null]
  input_amount decimal(12,3) [not null]
  input_unit varchar [not null]
  prepared_amount decimal(12,3)
  prepared_unit varchar
  nutrient_basis jsonb [note: 'Leaf: published name, food state, source, base G/ML, values per 100, allergens']
  position integer [not null]
  Note: 'Exactly one ingredient or pinned subrecipe. Leaf input uses nutrient base unit; subrecipe uses its yield unit. Prepared amount and unit are paired.'
}

Table steps as Steps {
  id uuid [pk]
  variant_id uuid [not null, ref: > Variants.id]
  optional_line_id uuid [ref: > VariantLines.id, note: 'omit step when its optional line is excluded']
  position integer [not null]
  text text [not null]
  duration_seconds integer [null]
}

Table tags as Tags {
  recipe_version_id uuid [not null, ref: > Versions.id]
  tag_type varchar [not null]
  tag_value varchar [not null]

  Note: 'Service: Recipe'
}

Table favorites as Favorites {
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  recipe_id uuid [not null, ref: > Recipes.id]
  created_at timestamptz [not null]

  indexes {
    (user_id, recipe_id) [pk]
  }

  Note: 'Service: Recipe'
}

Table feedback as Feedback {
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  recipe_id uuid [not null, ref: > Recipes.id]
  feedback varchar [not null, note: 'LIKE | DO_NOT_RECOMMEND']
  updated_at timestamptz [not null]

  indexes {
    (user_id, recipe_id) [pk]
  }

  Note: 'Service: Recipe'
}

Table cooking_sessions as CookingSessions {
  id uuid [pk]
  user_id uuid [not null, note: 'logical ref -> Identity.accounts.id']
  variant_id uuid [not null, ref: > Variants.id]
  excluded_line_ids jsonb [not null, note: 'Distinct optional IDs from the selected variant']
  planned_cook_id uuid [note: 'Logical ref to Meal Planner, optional for catalog cooks']
  ingredient_scale decimal(12,6) [not null]
  actual_yield_amount decimal(12,3)
  actual_yield_unit varchar [note: 'Paired, positive and required on completion']
  status varchar [not null, note: 'IN_PROGRESS | COMPLETED | CANCELLED']
  started_at timestamptz [not null]
  completed_at timestamptz [null]

  Note: 'Service: Recipe'
}
