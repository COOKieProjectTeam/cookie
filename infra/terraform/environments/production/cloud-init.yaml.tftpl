#cloud-config
ssh_pwauth: false
disable_root: true
package_update: false
package_upgrade: false

groups:
  - docker

users:
  - default
  - name: ${admin_username}
    gecos: COOKie production operator
    groups: [adm, docker]
    lock_passwd: true
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

write_files:
  - path: /etc/ssh/sshd_config.d/60-cookie-hardening.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
  - path: /etc/docker/daemon.json
    owner: root:root
    permissions: "0644"
    content: |
      {
        "live-restore": true,
        "log-driver": "local",
        "log-opts": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
  - path: /usr/local/sbin/cookie-bootstrap
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -Eeuo pipefail
      export DEBIAN_FRONTEND=noninteractive

      data_device=/dev/disk/by-id/virtio-cookie-data
      for attempt in $(seq 1 60); do
        if [ -b "$data_device" ]; then
          break
        fi
        sleep 1
      done
      if [ ! -b "$data_device" ]; then
        echo "Attached cookie-data disk was not found" >&2
        exit 1
      fi

      if ! filesystem_type=$(blkid -p -s TYPE -o value "$data_device"); then
        echo "Cannot identify cookie-data; initialize a verified new disk manually or recover the existing disk" >&2
        exit 1
      fi
      if [ "$filesystem_type" != ext4 ]; then
        echo "Refusing to mount cookie-data with unexpected filesystem: $filesystem_type" >&2
        exit 1
      fi
      if ! data_uuid=$(blkid -p -s UUID -o value "$data_device") || [ -z "$data_uuid" ]; then
        echo "Cannot read cookie-data filesystem UUID; recover the existing disk before retrying" >&2
        exit 1
      fi
      install -d -m 0750 /srv/cookie
      if ! grep -q "^UUID=$data_uuid " /etc/fstab; then
        printf 'UUID=%s /srv/cookie ext4 defaults,nofail 0 2\n' "$data_uuid" >> /etc/fstab
      fi
      mountpoint -q /srv/cookie || mount /srv/cookie

      apt-get update
      apt-get install -y --no-install-recommends ca-certificates curl jq unattended-upgrades util-linux
      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      chmod a+r /etc/apt/keyrings/docker.asc
      . /etc/os-release
      architecture=$(dpkg --print-architecture)
      cat > /etc/apt/sources.list.d/docker.sources <<EOF
      Types: deb
      URIs: https://download.docker.com/linux/ubuntu
      Suites: $${VERSION_CODENAME}
      Components: stable
      Architectures: $architecture
      Signed-By: /etc/apt/keyrings/docker.asc
      EOF
      apt-get update
      apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

      install -d -m 0750 -o root -g ${admin_username} /opt/cookie /etc/cookie
      install -d -m 0750 -o 70 -g 70 /srv/cookie/postgres
      install -d -m 0750 -o 1000 -g 1000 /srv/cookie/nats
      usermod -aG docker ${admin_username}
      systemctl enable --now docker
      systemctl reload ssh || systemctl reload sshd

runcmd:
  - [/usr/local/sbin/cookie-bootstrap]

final_message: "COOKie production cloud-init finished; check cloud-init status before deployment"
