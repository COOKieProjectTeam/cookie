# Static, non-release production settings. Install as
# /etc/cookie/production.env with mode 0600 and root ownership.
YC_REGISTRY_ID=replace-with-yandex-container-registry-id
COOKIE_DATA_ROOT=/srv/cookie
COOKIE_SECRET_ROOT=/srv/cookie/secrets

# Terraform limits port 8080 to the internal API Gateway source range. Use
# 127.0.0.1 only if that gateway is deliberately removed and access is by SSH
# tunnel alone.
COOKIE_IDENTITY_BIND_IP=0.0.0.0

# Until a custom domain exists, use the HTTPS URL assigned by API Gateway.
COOKIE_IDENTITY_ISSUER=https://replace-with-api-gateway-service-domain
COOKIE_IDENTITY_AUDIENCE=cookie-api

# Must match the source range admitted by the Terraform security group.
COOKIE_IDENTITY_TRUSTED_PROXY_CIDRS=198.19.0.0/16

# Optional comma-separated files inside the Identity container. Mount those
# retiring public JWKs into /srv/cookie/secrets/identity/retiring first.
COOKIE_IDENTITY_JWT_RETIRING_PUBLIC_KEY_PATHS=
